# 월부 중급반 Codex 프로젝트 로컬 설정 예시
# 이 파일을 복사해서 .env.local 을 만들고 실제 값을 입력함.
# .env.local 은 절대 공유하지 않음.

# 공통 (수강 코드는 강의 자료실 공지 확인 후, 터미널에서 `키설정`으로 입력)
MAKEIT_MIDDLE_LICENSE=your-course-code
OPENAI_API_KEY=sk-your-openai-api-key
# OpenAI 에 충전한 금액(달러). 넣으면 글마다 "남은 돈 약 N원 (M%)" 을 보여준다. 키설정에서 입력.
OPENAI_BUDGET_USD=
OPENAI_BUDGET_SET_AT=

# 승인글을 올릴 워드프레스 사이트 (최대 10개)
# 쓰는 만큼만 채우면 됨. 빈 칸은 그대로 두면 무시된다.
# 입력은 터미널에 '키설정' 으로 하는 게 가장 쉽다 (입력 즉시 연결 확인까지 해줌).
ADSENSE_SITE_01_URL=https://example-1.com
ADSENSE_SITE_01_USER=your-admin-id
ADSENSE_SITE_01_APP_PASSWORD=xxxx xxxx xxxx xxxx xxxx xxxx

ADSENSE_SITE_02_URL=https://example-2.com
ADSENSE_SITE_02_USER=your-admin-id
ADSENSE_SITE_02_APP_PASSWORD=xxxx xxxx xxxx xxxx xxxx xxxx

ADSENSE_SITE_03_URL=https://example-3.com
ADSENSE_SITE_03_USER=your-admin-id
ADSENSE_SITE_03_APP_PASSWORD=xxxx xxxx xxxx xxxx xxxx xxxx

ADSENSE_SITE_04_URL=https://example-4.com
ADSENSE_SITE_04_USER=your-admin-id
ADSENSE_SITE_04_APP_PASSWORD=xxxx xxxx xxxx xxxx xxxx xxxx

ADSENSE_SITE_05_URL=https://example-5.com
ADSENSE_SITE_05_USER=your-admin-id
ADSENSE_SITE_05_APP_PASSWORD=xxxx xxxx xxxx xxxx xxxx xxxx

ADSENSE_SITE_06_URL=https://example-6.com
ADSENSE_SITE_06_USER=your-admin-id
ADSENSE_SITE_06_APP_PASSWORD=xxxx xxxx xxxx xxxx xxxx xxxx

ADSENSE_SITE_07_URL=https://example-7.com
ADSENSE_SITE_07_USER=your-admin-id
ADSENSE_SITE_07_APP_PASSWORD=xxxx xxxx xxxx xxxx xxxx xxxx

ADSENSE_SITE_08_URL=https://example-8.com
ADSENSE_SITE_08_USER=your-admin-id
ADSENSE_SITE_08_APP_PASSWORD=xxxx xxxx xxxx xxxx xxxx xxxx

ADSENSE_SITE_09_URL=https://example-9.com
ADSENSE_SITE_09_USER=your-admin-id
ADSENSE_SITE_09_APP_PASSWORD=xxxx xxxx xxxx xxxx xxxx xxxx

ADSENSE_SITE_10_URL=https://example-10.com
ADSENSE_SITE_10_USER=your-admin-id
ADSENSE_SITE_10_APP_PASSWORD=xxxx xxxx xxxx xxxx xxxx xxxx

# 애드센스 승인글 자동화 기본값
ARTICLE_MODEL=gpt-5.4-mini
ARTICLE_MIN_CHARS=3000
DEFAULT_POST_STATUS=draft
ARTICLE_USD_KRW=1543.57527
IMAGE_MODEL=gpt-image-1-mini
IMAGE_QUALITY=low
IMAGE_SIZE=1536x1024
IMAGE_OUTPUT_FORMAT=jpeg

# 예전 단일 워드프레스 구조 호환용
WORDPRESS_URL=https://example.com
WORDPRESS_USER=your-admin-id
WORDPRESS_APP_PASSWORD=xxxx xxxx xxxx xxxx xxxx xxxx
