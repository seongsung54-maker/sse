#!/usr/bin/env bash
# 시작 — AI 비서(코덱스)를 켭니다. (D4: CLI TUI 가 기본 흐름)
set -u

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
PROGRAM_DIR="$ROOT/99_절대_건들지마세요_프로그램파일"
CODEX_RUNTIME_DIR="$PROGRAM_DIR/runtime/codex"
CODEX_BIN="$CODEX_RUNTIME_DIR/node_modules/.bin/codex"

# 원본 키트에서 열었다면 여기서 멈춘다 (작업을 해봐야 저장이 안 된다)
. "$(dirname "${BASH_SOURCE[0]}")/_공통.sh"
guard_template_repo "$ROOT"

echo "[시작] AI 비서(코덱스)를 켭니다..."

# CODEX_HOME 은 devcontainer 가 워크스페이스 내부로 지정 (D6). 없으면 동일 규칙으로 보정.
export CODEX_HOME="${CODEX_HOME:-$ROOT/.codex}"

# ── 못 쓰는 모델 지정 걷어내기 (예전 작업방 자가 복구) ──────────────────
# ChatGPT 구독 계정으로는 gpt-5.4-mini 같은 모델을 쓸 수 없어서, 예전 설정이 남아 있으면
# 첫 실행이 400 오류로 죽는다. 모델 지정을 지우면 계정에 맞는 기본 모델이 쓰인다.
CODEX_CONFIG="$CODEX_HOME/config.toml"
if [ -f "$CODEX_CONFIG" ] && grep -qE '^[[:space:]]*model[[:space:]]*=[[:space:]]*"gpt-' "$CODEX_CONFIG"; then
  sed -i.bak -E '/^[[:space:]]*model[[:space:]]*=[[:space:]]*"gpt-/d' "$CODEX_CONFIG"
  rm -f "$CODEX_CONFIG.bak"
  echo "[시작] 예전 모델 설정을 정리했어요. (ChatGPT 계정에서 못 쓰는 값이었어요)"
fi

# ── 코덱스가 아직 설치 전이면 여기서 설치 (setup.sh 실패 대비 자가 복구) ──
if [ ! -x "$CODEX_BIN" ]; then
  echo "코덱스가 아직 설치되어 있지 않아 지금 설치합니다. 1~2분만 기다려 주세요..."
  if ! npm install --prefix "$CODEX_RUNTIME_DIR" --no-audit --no-fund @openai/codex@latest; then
    echo ""
    echo "❌ 코덱스 설치에 실패했어요."
    echo "   터미널에 '진단' 을 입력한 결과를 복사해 문의 채널에 올려 주세요."
    exit 1
  fi
fi

# ── 첫 출력이 나올 때까지 돌리는 로딩 표시 ──────────────────
#
# codex login 은 서버에서 기기 코드를 받아오느라 몇 초…몇십 초를 조용히 기다린다.
# 그 사이 화면에 아무것도 안 나와서 수강생은 멈춘 줄 알고 창을 닫아 버린다.
#
# 출력을 파일로 받아 두고, 거기 첫 글자가 찍힐 때까지만 스피너를 돌린다.
# 본채 출력이 시작되면 스피너 줄을 지우고 그대로 흘려보낸다 — 그래야 둘이 섞이지 않는다.
run_with_spinner() {
  local msg="$1"
  shift

  # 터미널이 아니면(파이프·로그) 장식 없이 그냥 실행한다
  if [ ! -t 1 ]; then
    "$@"
    return $?
  fi

  local out
  out="$(mktemp)"
  # stdin 은 터미널에 붙여 둔다 (로그인이 입력을 받아야 할 때를 대비)
  "$@" >"$out" 2>&1 <&0 &
  local pid=$!

  local frames=(⠋ ⠙ ⠹ ⠸ ⠼ ⠴ ⠦ ⠧ ⠇ ⠏)
  local i=0
  while kill -0 "$pid" 2>/dev/null && [ ! -s "$out" ]; do
    printf '\r  \033[36m%s\033[0m %s' "${frames[$((i % 10))]}" "$msg"
    i=$((i + 1))
    sleep 0.12
  done
  printf '\r\033[2K'

  # 남은 출력을 끝날 때까지 그대로 보여 준다.
  #
  # tail -f --pid 를 써 봤는데 마지막 한 줄을 놓치는 일이 있었다(실측:
  # "Welcome to Codex" 가 사라짐). 프로세스가 끝나는 순간과 마지막
  # 쓰기가 겹쳐서다. 그래서 직접 읽은 위치를 세면서 전달한다.
  local shown=0 size
  while :; do
    size=$(wc -c <"$out" 2>/dev/null || echo 0)
    if [ "$size" -gt "$shown" ]; then
      tail -c "+$((shown + 1))" "$out"
      shown=$size
    fi
    kill -0 "$pid" 2>/dev/null || break
    sleep 0.1
  done
  # 끝난 뒤에 찍힌 게 있을 수 있으니 한 번 더
  size=$(wc -c <"$out" 2>/dev/null || echo 0)
  if [ "$size" -gt "$shown" ]; then
    tail -c "+$((shown + 1))" "$out"
  fi

  wait "$pid"
  local rc=$?
  rm -f "$out"
  return $rc
}

# ── 로그인 여부 확인: CODEX_HOME/auth.json 이 없으면 기기 코드 로그인 안내 (D5) ──
if [ ! -f "$CODEX_HOME/auth.json" ]; then
  echo ""
  echo "첫 사용이라 ChatGPT 로그인이 필요해요. 아래 순서만 따라 하면 됩니다."
  echo ""
  echo "  1) 잠시 뒤 터미널에 코드와 인터넷 주소가 나옵니다."
  echo "  2) 코드는 마우스로 드래그한 뒤 우클릭 → 복사 (Ctrl+C 는 복사가 아니에요!)"
  echo "  3) 주소를 Ctrl(맥은 Cmd) 누른 채 클릭해 새 탭에서 열고, 코드를 붙여넣어 승인"
  echo ""
  echo "  ※ 승인이 안 되면: ChatGPT 설정 → 보안 및 로그인 → 맨 아래"
  echo "    'Codex용 장치 코드 인증 활성화'가 켜져 있는지 먼저 확인하세요. (온보딩 0단계)"
  echo ""
  if ! run_with_spinner "ChatGPT 연결 준비 중입니다. 잠시만요 (10~30초)" "$CODEX_BIN" login --device-auth; then
    echo ""
    echo "❌ 로그인에 실패했어요. 위 안내(0단계 토글)를 확인한 뒤 다시 '시작' 을 입력해 주세요."
    exit 1
  fi
  echo ""
  echo "✅ 로그인 성공! 이어서 AI 비서를 켭니다."
fi

# ── 저장소 루트를 작업 폴더로 하여 코덱스 실행 (AGENTS.md 라우팅이 루트 기준) ──
cd "$ROOT"

# 코덱스 화면이 뜨기까지도 몇 초 걸린다. exec 는 프로세스를 통째로 바꿔치므로
# 스피너를 돌릴 수는 없고, 대신 "지금 뜼는 중"이라고 한 줄 남겨 둔다.
if [ -t 1 ]; then
  printf '  \033[36m⠋\033[0m AI 비서 화면을 띄우는 중이에요...\n'
fi

exec "$CODEX_BIN"
